# ==========================================================
# MySQL 客户端配置
# ==========================================================

[client]

# 设置客户端默认字符集
#
# 作用：
# - 控制 mysql 命令行客户端连接时使用的字符集
# - 防止中文乱码
# - 支持完整 Unicode 字符
# - 支持 emoji、特殊符号等 4 字节字符
#
default-character-set=utf8mb4



# ==========================================================
# MySQL 服务端配置
# ==========================================================

[mysqld]


# ==========================================================
# 字符集配置
# ==========================================================

# 设置 MySQL 服务端默认字符集
#
# utf8mb4：
# - MySQL 真正完整 UTF-8 实现
# - 最大支持 4 字节字符
# - 推荐生产环境统一使用
#
# 不推荐使用 utf8：
# - MySQL 的 utf8 实际是 utf8mb3
# - 最大只支持 3 字节
# - 无法保存部分 emoji 和特殊字符
#
character-set-server=utf8mb4


# 设置默认排序规则
#
# utf8mb4_unicode_ci：
# - unicode 排序规则
# - ci = case insensitive（大小写不敏感）
#
# 例如：
# 'A' = 'a'
#
# 适合大多数业务系统
#
collation-server=utf8mb4_unicode_ci



# ==========================================================
# 连接优化配置
# ==========================================================

# 禁止 MySQL 对客户端 IP 进行 DNS 反向解析
#
# 默认流程：
#
# 客户端连接
#       |
#       v
# 获取客户端 IP
#       |
#       v
# DNS 查询 IP 对应主机名
#       |
#       v
# 根据主机名匹配 mysql.user
#
# 问题：
# - DNS 不稳定时连接速度变慢
# - 内网环境没有 DNS 时可能阻塞
#
# 开启后：
# - MySQL 直接使用 IP 匹配用户
# - 提升连接速度
#
# Docker、云服务器、微服务环境推荐开启
#
# 注意：
# 开启后不要创建：
# 'root'@'hostname'
#
# 推荐：
# 'root'@'%'
# 'app'@'192.168.1.%'
#
skip-name-resolve



# ==========================================================
# 时区配置
# ==========================================================

# 设置 MySQL 默认时区
#
# +08:00 表示东八区
# 对应：
# 中国标准时间 CST
#
# 作用：
# - 避免 Java 日期时间转换错误
# - 避免 timestamp 存储和读取时间偏移
#
default-time-zone='+08:00'



# ==========================================================
# SQL 模式配置
# ==========================================================

# 开启严格 SQL 模式
#
# STRICT_TRANS_TABLES：
# - 对事务表启用严格检查
# - 插入非法数据直接报错
#
# NO_ENGINE_SUBSTITUTION：
# - 指定存储引擎不存在时不自动替换
#
# 防止：
# - 数据被自动截断
# - 错误数据进入数据库
#
# 例如：
# VARCHAR(5) 插入超过5个字符
# 严格模式下直接报错
#
sql_mode=STRICT_TRANS_TABLES,NO_ENGINE_SUBSTITUTION



# ==========================================================
# InnoDB 存储引擎配置
# ==========================================================

# InnoDB 缓冲池大小
#
# 作用：
# - 缓存表数据
# - 缓存索引
# - 减少磁盘 IO
#
# 推荐：
# - 生产环境一般设置为服务器内存 50%~70%
#
# 示例：
# 4G服务器 -> 2G左右
# 8G服务器 -> 4G左右
#
# 当前设置：
# 1G
#
# 适合：
# - 开发环境
# - 小型业务服务器
#
innodb_buffer_pool_size=1G



# InnoDB redo log 容量
#
# 作用：
# - 保存事务日志
# - 提高事务恢复能力
# - 提升写入性能
#
# 设置过小：
# - 高频刷盘
# - 写性能下降
#
# 设置过大：
# - 恢复时间增加
#
innodb_redo_log_capacity=512M



# ==========================================================
# 慢 SQL 查询日志
# ==========================================================

# 开启慢查询日志
#
# 记录执行时间超过 long_query_time 的 SQL
#
# 用于：
# - SQL 性能分析
# - 索引优化
# - 排查慢接口
#
slow_query_log=ON



# 慢查询日志文件路径
#
# Docker中：
# /var/log/mysql
#
# 已映射：
# ./mysql/log:/var/log/mysql
#
# 宿主机查看：
# ./mysql/log/slow.log
#
slow_query_log_file=/var/log/mysql/slow.log



# SQL执行超过多少秒记录
#
# 当前：
# 0.3秒
#
# 表示：
# SQL执行时间 > 300ms
# 会记录到慢查询日志
#
# 开发环境建议：
# 0.3~1秒
#
# 生产环境：
# 1~2秒
#
long_query_time=0.3



# ==========================================================
# 连接配置
# ==========================================================

# 最大客户端连接数量
#
# 超过数量：
# 新连接会拒绝
#
# 根据业务调整：
#
# 小项目：
# 100~300
#
# 中型项目：
# 500+
#
max_connections=200



# ==========================================================
# 临时表配置
# ==========================================================

# 内存临时表最大大小
#
# SQL执行过程中：
# - GROUP BY
# - ORDER BY
# - DISTINCT
#
# 可能创建临时表
#
# 太小：
# 临时表写磁盘
#
# 太大：
# 占用过多内存
#
tmp_table_size=64M



# MEMORY引擎临时表最大大小
#
# 建议和 tmp_table_size 保持一致
#
max_heap_table_size=64M



# ==========================================================
# 表缓存配置
# ==========================================================

# 表文件缓存数量
#
# MySQL打开表时：
# 会缓存表结构和文件句柄
#
# 提高：
# - 高频查询性能
# - 减少文件打开关闭次数
#
# 适合：
# 表数量较多的业务系统
#
table_open_cache=4000



# ==========================================================
# 数据包大小配置
# ==========================================================

# 单次通信允许的最大数据包大小
#
# 影响：
# - 大字段
# - 大批量 INSERT
# - TEXT/BLOB 数据
#
# 默认：
# 64MB
#
# 防止：
# Packet too large 错误
#
max_allowed_packet=64M