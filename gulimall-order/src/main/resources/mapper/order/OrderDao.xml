<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.atguigu.gulimall.order.dao.OrderDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.atguigu.gulimall.order.entity.OrderEntity" id="orderMap">
        <result property="id" column="id"/>
        <result property="memberId" column="member_id"/>
        <result property="orderSn" column="order_sn"/>
        <result property="couponId" column="coupon_id"/>
        <result property="createTime" column="create_time"/>
        <result property="memberUsername" column="member_username"/>
        <result property="totalAmount" column="total_amount"/>
        <result property="payAmount" column="pay_amount"/>
        <result property="freightAmount" column="freight_amount"/>
        <result property="promotionAmount" column="promotion_amount"/>
        <result property="integrationAmount" column="integration_amount"/>
        <result property="couponAmount" column="coupon_amount"/>
        <result property="discountAmount" column="discount_amount"/>
        <result property="payType" column="pay_type"/>
        <result property="sourceType" column="source_type"/>
        <result property="status" column="status"/>
        <result property="deliveryCompany" column="delivery_company"/>
        <result property="deliverySn" column="delivery_sn"/>
        <result property="autoConfirmDay" column="auto_confirm_day"/>
        <result property="integration" column="integration"/>
        <result property="growth" column="growth"/>
        <result property="billType" column="bill_type"/>
        <result property="billHeader" column="bill_header"/>
        <result property="billContent" column="bill_content"/>
        <result property="billReceiverPhone" column="bill_receiver_phone"/>
        <result property="billReceiverEmail" column="bill_receiver_email"/>
        <result property="receiverName" column="receiver_name"/>
        <result property="receiverPhone" column="receiver_phone"/>
        <result property="receiverPostCode" column="receiver_post_code"/>
        <result property="receiverProvince" column="receiver_province"/>
        <result property="receiverCity" column="receiver_city"/>
        <result property="receiverRegion" column="receiver_region"/>
        <result property="receiverDetailAddress" column="receiver_detail_address"/>
        <result property="note" column="note"/>
        <result property="confirmStatus" column="confirm_status"/>
        <result property="deleteStatus" column="delete_status"/>
        <result property="useIntegration" column="use_integration"/>
        <result property="paymentTime" column="payment_time"/>
        <result property="deliveryTime" column="delivery_time"/>
        <result property="receiveTime" column="receive_time"/>
        <result property="commentTime" column="comment_time"/>
        <result property="modifyTime" column="modify_time"/>
    </resultMap>

    <!-- ==================== 后台交易统计 ====================
         统计口径：已支付订单（status 1/2/3），时间按 payment_time 过滤。
         keyword 命中商品名时，交易额/订单数/件数都只统计包含该商品的订单，
         保证三块数据口径一致。 -->
    <sql id="paidOrderFilter">
        o.status IN (1, 2, 3)
        AND o.payment_time BETWEEN #{start} AND #{end}
        <if test="keyword != null and keyword != ''">
            AND EXISTS (
                SELECT 1 FROM oms_order_item k
                WHERE k.order_id = o.id
                  AND k.sku_name LIKE CONCAT('%', #{keyword}, '%')
            )
        </if>
    </sql>

    <select id="selectSummary" resultType="com.atguigu.gulimall.order.vo.OrderStatVo">
        SELECT
            COALESCE(SUM(t.pay_amount), 0) AS totalAmount,
            COUNT(*) AS orderCount,
            COALESCE(SUM(t.item_count), 0) AS itemCount
        FROM (
            SELECT o.id,
                   o.pay_amount,
                   (SELECT COALESCE(SUM(i.sku_quantity), 0)
                    FROM oms_order_item i
                    WHERE i.order_id = o.id) AS item_count
            FROM oms_order o
            WHERE <include refid="paidOrderFilter"/>
        ) t
    </select>

    <select id="selectDailyTrend" resultType="com.atguigu.gulimall.order.vo.OrderStatVo$TrendPoint">
        SELECT DATE_FORMAT(o.payment_time, '%Y-%m-%d') AS date,
               COALESCE(SUM(o.pay_amount), 0) AS amount,
               COUNT(*) AS orderCount
        FROM oms_order o
        WHERE <include refid="paidOrderFilter"/>
        GROUP BY DATE_FORMAT(o.payment_time, '%Y-%m-%d')
        ORDER BY date
    </select>

    <select id="selectTopProducts" resultType="com.atguigu.gulimall.order.vo.OrderStatVo$ProductRank">
        SELECT i.sku_id AS skuId,
               i.sku_name AS skuName,
               COALESCE(SUM(i.sku_quantity), 0) AS quantity,
               COALESCE(SUM(i.real_amount), 0) AS amount
        FROM oms_order_item i
        JOIN oms_order o ON o.id = i.order_id
        WHERE <include refid="paidOrderFilter"/>
        <if test="keyword != null and keyword != ''">
            AND i.sku_name LIKE CONCAT('%', #{keyword}, '%')
        </if>
        GROUP BY i.sku_id, i.sku_name
        ORDER BY quantity DESC
        LIMIT #{limit}
    </select>

    <select id="selectStatusDistribution" resultType="com.atguigu.gulimall.order.vo.OrderStatVo$NameValue">
        SELECT CASE o.status
                   WHEN 1 THEN '待发货'
                   WHEN 2 THEN '已发货'
                   WHEN 3 THEN '已完成'
                   ELSE '其它'
               END AS name,
               COUNT(*) AS `value`
        FROM oms_order o
        WHERE <include refid="paidOrderFilter"/>
        GROUP BY o.status
        ORDER BY `value` DESC
    </select>

    <select id="selectPayTypeDistribution" resultType="com.atguigu.gulimall.order.vo.OrderStatVo$NameValue">
        SELECT CASE o.pay_type
                   WHEN 1 THEN '支付宝'
                   WHEN 2 THEN '微信'
                   WHEN 3 THEN '银联'
                   WHEN 4 THEN '货到付款'
                   ELSE '其它'
               END AS name,
               COUNT(*) AS `value`
        FROM oms_order o
        WHERE <include refid="paidOrderFilter"/>
        GROUP BY o.pay_type
        ORDER BY `value` DESC
    </select>

</mapper>