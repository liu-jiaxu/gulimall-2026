# ============================================================
# docker compose 用的变量
# ------------------------------------------------------------
# ⚠️ 格式是 KEY=VALUE，不是 YAML —— 所以文件名用 .env 而不是 .yaml。
#    compose 的 --env-file 只认这种格式，写成 YAML 会解析失败。
#
# 用法（在虚拟机 /mydata/docker 目录下执行）：
#   docker compose --env-file /mydata/app/config/docker-compose.env up -d
#
# 之所以不把 .env 直接放 /mydata/docker/ 下（compose 会默认自动读取），
# 是为了让所有真实配置都集中在 config/ 一个目录里，跟服务的 yaml 放一起。
# ============================================================

# ---------- 宿主机（Windows）的局域网 IP ----------
# 容器靠 host.docker.internal 回连宿主机上跑的 Java 进程（网关/product/search）。
# ⚠️ Windows 走 DHCP，换网络后 IP 会变 —— 变了就改这里，不用动 docker-compose.yaml。
WINDOWS_HOST_IP=<your-windows-host-ip>
# TODO
# 部署时：Java 服务搬到虚拟机上，用 host-gateway 指回宿主机
# host-gateway 是 Docker 的一个特殊关键字，意思是「容器所在的那台宿主机」。Docker 看到它，会自动替换成 Docker 网桥的 IP（172.17.0.1）。
# 172.17.0.1 是 Docker 在虚拟机上创建的一块"虚拟网卡"，不是虚拟机的对外 IP。
# WINDOWS_HOST_IP=host-gateway

# ---------- 虚拟机（Docker 宿主）的局域网 IP ----------
# RocketMQ brokerIP1、Seata SEATA_IP 等注册地址都用它；
# 换 IP 只改这里，再重建对应容器。
VM_HOST_IP=<your-vm-host-ip>

# ---------- 各中间件的凭据 ----------
MYSQL_ROOT_PASSWORD=<your-password>

REDIS_PASSWORD=<your-password>

MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=<your-password>

ELASTIC_PASSWORD=<your-password>

# Nacos 2.2.1+ 必须显式配置，否则启动报错。
# ⚠️ 这是明文密钥，生产环境请用 openssl rand -base64 32 重新生成。
NACOS_AUTH_TOKEN=<your-nacos-auth-token>

# RabbitMQ：镜像启动时会用这两个值创建默认用户，同时【不再创建 guest 用户】
# （guest 默认只允许从本机登录，我们连的是宿主机/局域网，用 guest 连不上）
RABBITMQ_USERNAME=root
RABBITMQ_PASSWORD=<your-password>

# RocketMQ ACL 1.0 凭据
# ⚠️ 三处必须完全一致：
#   1) 本文件（Dashboard 连接用）
#   2) config/common.yaml 的 ROCKETMQ_ACCESS_KEY / ROCKETMQ_SECRET_KEY（Java 客户端用）
#   3) deploy/rocketmq/broker/conf/plain_acl.yml（Broker 校验用；仓库里是占位符，
#      部署时要在服务器上把它改成这里的值）
ROCKETMQ_ACCESS_KEY=gulimall
ROCKETMQ_SECRET_KEY=<your-password>

# ---------- Milvus 向量库 ----------
# Milvus 自己带一个 MinIO，专门存向量索引，不与业务 MinIO 混用，避免误删。
# 这两个值会同时注入 milvus-minio 和 milvus 两个容器，必须由同一份 env 提供；
# 不带 --env-file 时变量为空，Milvus 会报 signature mismatch。
MILVUS_MINIO_ACCESS_KEY=milvus
MILVUS_MINIO_SECRET_KEY=<your-password>
# Milvus 自身的 root 密码（当前 compose 已开启鉴权）
# ⚠️ 必须与 config/common.yaml 的 MILVUS_PASSWORD 完全一致
MILVUS_ROOT_PASSWORD=<your-password>
# Milvus standalone 内存上限；虚拟机上至少留 2G，否则会被 OOM
MILVUS_MEM_LIMIT=2g
